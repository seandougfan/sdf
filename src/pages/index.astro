---
import Layout from '../layouts/Layout.astro';
import questions from '../data/questions.json';
---
<Layout>
  <section class="personal-home" aria-label="Introduction">
    <p class="opening">I’m Sean. I’ve spent the last decade and a half building and investing in companies, from inception through growth.</p>
  </section>

  <section id="work" class="home-section narrative">
    <h2>Work & background</h2>
    <ul class="skim-list work-list">
      <li><a href="https://www.meritholdings.com/" target="_blank" rel="noreferrer">Merit Holdings</a> <span>— Long-term ownership, durable growth &amp; applied AI.</span></li>
      <li><a href="https://www.racepace.cc/" target="_blank" rel="noreferrer">Racepace</a> <span>— Coaching and community for endurance athletes.</span></li>
      <li><a href="https://pathlight.vc/" target="_blank" rel="noreferrer">Pathlight Ventures</a> <span>— Inception and pre-seed through early Series A.</span></li>
      <li><a href="https://openviewpartners.com/" target="_blank" rel="noreferrer">OpenView</a> <span>— Growth investing. Series A, Series B, and beyond.</span></li>
      <li><a href="https://dispatch.me/" target="_blank" rel="noreferrer">Dispatch</a> <span>— Company building in field services software.</span></li>
    </ul>
    <p class="background-note">Across product, go-to-market, fundraising, and corporate development. Across B2B and consumer businesses.</p>
  </section>

  <section id="conversation" class="home-section narrative">
    <h2>Talk to me about</h2>
    <ul class="skim-list">
      <li>You have early customers getting value, but haven’t found a repeatable way to reach more.</li>
      <li>You’re assessing a business’s capacity for durable growth and where applied AI can strengthen it.</li>
      <li>You’re exploring an unusual ownership or capital structure, particularly where data, software, and operating businesses meet.</li>
    </ul>
    <a class="inline-link" href="mailto:s@sdf.tech">Let’s compare notes ↗</a>
  </section>

  <section id="questions" class="home-section narrative">
    <h2>Questions I keep coming back to</h2>
    <ul class="skim-list question-list">
      {questions.map(({ topic, question, href }) => <li><strong>{topic}{/[.!?]$/.test(topic) ? '' : '.'}</strong> {question}{href && <a class="question-note" href={href}>Working note ↗</a>}</li>)}
    </ul>
  </section>

  <section id="writing" class="home-section">
    <h2>Selected writing</h2>
    <a class="writing-item" href="https://seanfanning.substack.com" target="_blank" rel="noreferrer"><span class="writing-title">Capital Markets Roundup <span>↗</span></span><span class="writing-description">My archive of writing on markets and companies.</span></a>
    <a class="writing-item" href="https://www.racepace.cc/blog/leadville-100-training" target="_blank" rel="noreferrer"><span class="writing-title">My Leadville 100 Training <span>↗</span></span><span class="writing-description">Structure, consistency, and the preparation behind a long day on the bike.</span></a>
    <a class="writing-item" href="https://www.racepace.cc/blog/my-leadville-100-fueling-strategy" target="_blank" rel="noreferrer"><span class="writing-title">My Leadville 100 Fueling Strategy <span>↗</span></span><span class="writing-description">The plan, the constraints, and what actually happened on race day.</span></a>
  </section>

  <section class="home-section narrative personal-section">
    <h2>Outside work</h2>
    <ul class="skim-list">
      <li>Cycling, training, and racing. Leadville 100 finisher.</li>
      <li>Former president and captain, Boston College men’s rowing.</li>
    </ul>
  </section>
</Layout>
