---
import Layout from '../../layouts/Layout.astro';
const posts = Object.values(import.meta.glob('./*.md', { eager: true })).sort((a: any, b: any) => String(b.frontmatter.date).localeCompare(String(a.frontmatter.date))) as any[];
---
<Layout title="Thoughts — Sean Fanning"><article><div class="page-label">NOTES & WRITING</div><h1>Thoughts.</h1><p>On companies, competition, and things I’m figuring out.</p>{posts.length ? posts.map(post => <a class="post-row" href={post.url}><span>{post.frontmatter.title}</span><small>{post.frontmatter.status || post.frontmatter.date} ↗</small></a>) : <section class="work-item"><span class="page-label">FROM THE ARCHIVE</span><h2>Capital Markets Roundup</h2><p>My old writing is on Substack. I’m bringing the archive over here soon.</p><a class="inline-link" href="https://seanfanning.substack.com" target="_blank" rel="noreferrer">Read on Substack ↗</a></section>}</article></Layout>
